# Copia este archivo a .env y ajusta los valores.
# El .env real NO se sube a git (está en .gitignore).

PROJECT_NAME="Sistema de Reservas API"

# Base de datos PostgreSQL.
# - Con Docker (docker compose up) la URL la pone docker-compose.yml.
# - En local, levanta solo la base con: docker compose up -d db
DATABASE_URL="postgresql+psycopg://reservas:reservas@localhost:5432/reservas"

# Para pruebas rápidas sin Postgres puedes usar SQLite:
# DATABASE_URL="sqlite:///./reservas.db"

# Clave para firmar la sesión del panel (mínimo 32 caracteres).
# En producción usa una propia: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="solo-desarrollo-cambia-esta-clave-en-produccion"
# HORAS_SESION=12

# Límites (opcional: estos son los valores por defecto).
# El plazo para pagar y el % de adelanto se cambian desde el panel.
# DIAS_MAXIMOS_RESERVA=7
# MAX_CANTIDAD_POR_PRODUCTO=10
# MAX_PRODUCTOS_POR_RESERVA=10
