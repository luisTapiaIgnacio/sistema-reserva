# Copia este archivo a .env y ajusta los valores.
# El .env real NO se sube a git (está en .gitignore).

PROJECT_NAME="Sistema de Reservas API"

# Base de datos. Por defecto SQLite (un archivo local).
# Para PostgreSQL sería: postgresql+psycopg://usuario:clave@localhost:5432/reservas
DATABASE_URL="sqlite:///./reservas.db"
