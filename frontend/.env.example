# Copia este archivo a .env.local y ajusta los valores.

# Dirección de la API (backend en Python). Con Docker la pone docker-compose.yml.
# Usa 127.0.0.1 y no "localhost" (con localhost cada llamada tarda casi un segundo más).
API_URL=http://127.0.0.1:8000/api/v1

# La cookie de sesión del panel viaja solo por HTTPS en producción.
# Para probar por http desde otra PC de la red (ej. http://192.168.1.50:3000) pon false.
# COOKIE_SECURE=false
